API_ID=telegram获取
API_HASH=telegram获取
PHONE_NUMBER=+8613012345678
SESSION_NAME=/app/session/feiniu_user
DOWNLOAD_DIR=/downloads

# 多个群/频道用英文逗号分隔
TARGET_CHATS=@,@

# 只下载这些扩展名
ALLOW_EXTS=.mp4,.mkv,.mov,.avi,.jpg,.jpeg,.png,.webp
DOWNLOAD_HISTORY=true
HISTORY_LIMIT=2000

MAX_RETRIES=3
RETRY_DELAY=5
MAX_FILE_SIZE_MB=0
