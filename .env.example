# Application
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated hostnames/IPs, or * for a trusted LAN deployment.
ALLOWED_HOSTS=*

# Docker and host bindings
APP_IMAGE_TAG=phase3
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
PUID=1000
PGID=1000

# Database and mounted storage roots
DATABASE_URL=sqlite:////app/data/app.db
SESSION_DIR=/app/session
DOWNLOAD_ROOT=/app/downloads
DOWNLOADS_VOLUME=./downloads
HASH_INDEX_FILE=/app/data/hash_index.json

# Telegram credentials (never commit real values)
API_ID=
API_HASH=
PHONE_NUMBER=
SESSION_NAME=/app/session/telegram_user

# Download runtime configuration
DOWNLOAD_DIR=/app/downloads
TARGET_CHATS=
ALLOW_EXTS=.mp4,.mkv,.mov,.avi,.jpg,.jpeg,.png,.webp
DOWNLOAD_HISTORY=true
HISTORY_LIMIT=2000
MAX_RETRIES=3
RETRY_DELAY=5
MAX_FILE_SIZE_MB=0

# Security
# When enabled, all /api POST/PUT/PATCH/DELETE calls require a Bearer token.
# Store only the lowercase SHA-256 hex digest of the chosen token.
ADMIN_AUTH_ENABLED=false
ADMIN_API_TOKEN_HASH=

# Logging
LOG_FILE=/app/logs/downloader.log
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Resource limits for a small NAS/server
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_CPU_LIMIT=0.5
FRONTEND_PIDS_LIMIT=128
BACKEND_MEMORY_LIMIT=512m
BACKEND_CPU_LIMIT=1.0
BACKEND_PIDS_LIMIT=256
WORKER_MEMORY_LIMIT=1g
WORKER_CPU_LIMIT=2.0
WORKER_PIDS_LIMIT=512

# Bounded temporary storage
FRONTEND_TMPFS_SIZE=32m
BACKEND_TMPFS_SIZE=128m
WORKER_TMPFS_SIZE=512m
